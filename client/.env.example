# ==============================================================================
# DriveX Frontend (React / Vite SPA) Environment Configuration Template
# ==============================================================================

# Backend API Base URL
# In local development: /api (Vite dev proxy in vite.config.ts forwards /api to http://localhost:5000)
# In production (e.g. Vercel): Set to your deployed backend API URL + /api
# Example: https://drivex-api.onrender.com/api
VITE_API_URL=/api
