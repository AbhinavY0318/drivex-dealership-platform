# ==============================================================================
# DriveX Monorepo Environment Configuration Template
# Copy this file to .env in the root directory for local full-stack development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS (CLIENT_ORIGIN or CLIENT_URL)
# Development default: http://localhost:5173
# Production (e.g. Vercel): https://your-drivex-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Development: Leave blank to automatically spin up built-in in-memory MongoMemoryServer.
# Production (Mandatory): MongoDB Atlas replica set URI
# Example: mongodb+srv://drivex_admin:<db_password>@cluster0.xxxxx.mongodb.net/drivex?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. Cryptographic JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Generate unique 32-byte hex secrets via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=drivex_super_secret_jwt_access_key_replace_in_production_2026
JWT_REFRESH_SECRET=drivex_super_secret_jwt_refresh_key_replace_in_production_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Google Gemini Generative AI (Optional)
# ------------------------------------------------------------------------------
# Free-tier API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left blank, DriveX automatically activates its built-in deterministic fallback engine.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Dealership Operational Defaults (Optional)
# ------------------------------------------------------------------------------
DEALERSHIP_CITY=Lucknow
DEALERSHIP_STATE=Uttar Pradesh
SLA_RESPONSE_TIME_MINUTES=5

# ------------------------------------------------------------------------------
# 6. Frontend Client Settings (Vite)
# ------------------------------------------------------------------------------
# Development: /api (Vite dev proxy forwards requests to http://localhost:5000)
# Production: Remote backend URL (e.g., https://drivex-api.onrender.com/api)
VITE_API_URL=/api
