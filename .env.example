# DriveX Environment Variables Configuration Template
# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide a MongoDB Atlas connection string for production or local mongod.
# If left blank in development, DriveX automatically starts an in-memory MongoDB instance.
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=drivex_super_secret_jwt_access_key_replace_in_production_2026
JWT_REFRESH_SECRET=drivex_super_secret_jwt_refresh_key_replace_in_production_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI Integration (Free Tier)
# If unconfigured or rate-limited, DriveX gracefully falls back to deterministic rule-based template generation.
GEMINI_API_KEY=

# Dealership Context
DEALERSHIP_CITY=Lucknow
DEALERSHIP_STATE=Uttar Pradesh
SLA_RESPONSE_TIME_MINUTES=5
