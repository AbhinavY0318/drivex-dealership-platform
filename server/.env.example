# ==============================================================================
# DriveX Backend (API Service) Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS (CLIENT_ORIGIN or CLIENT_URL)
# Local development: http://localhost:5173
# Production (e.g. Vercel): https://your-drivex-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# In development: Leave blank to auto-start built-in in-memory MongoMemoryServer.
# In production: Mandatory MongoDB connection URI (e.g., mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/drivex?retryWrites=true&w=majority)
MONGODB_URI=

# Cryptographic Authentication Secrets
# Generate random 32-byte hex strings via PowerShell / Node:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=drivex_super_secret_jwt_access_key_replace_in_production_2026
JWT_REFRESH_SECRET=drivex_super_secret_jwt_refresh_key_replace_in_production_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI Integration (Optional)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left blank, DriveX uses its built-in deterministic fallback engine (status: 'FALLBACK')
GEMINI_API_KEY=

# Dealership Operational Context (Optional Defaults)
DEALERSHIP_CITY=Lucknow
DEALERSHIP_STATE=Uttar Pradesh
SLA_RESPONSE_TIME_MINUTES=5
